<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                      http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
    <display-name>Smart Attendance Management</display-name>
    
    <!-- Listeners -->
    <listener>
        <listener-class>com.attendance.util.AppInitializer</listener-class>
    </listener>
    
    <!-- Servlet Mappings -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.attendance.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>RecordsServlet</servlet-name>
        <servlet-class>com.attendance.servlet.RecordsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RecordsServlet</servlet-name>
        <url-pattern>/records</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>AddStudentServlet</servlet-name>
        <servlet-class>com.attendance.servlet.AddStudentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddStudentServlet</servlet-name>
        <url-pattern>/add-student</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>AttendanceServlet</servlet-name>
        <servlet-class>com.attendance.servlet.AttendanceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AttendanceServlet</servlet-name>
        <url-pattern>/mark-attendance</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>StudentsApiServlet</servlet-name>
        <servlet-class>com.attendance.servlet.StudentsApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentsApiServlet</servlet-name>
        <url-pattern>/api/students</url-pattern>
    </servlet-mapping>
    
    <!-- Welcome Files -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
</web-app>
